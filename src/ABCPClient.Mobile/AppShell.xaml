<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ABCPClient.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#1B4F8A"
    Shell.TabBarForegroundColor="White"
    Shell.TabBarUnselectedColor="#A8C4E0"
    Shell.TabBarTitleColor="White"
    Title="ABCP Склад">

    <!-- Вкладки, а не выдвижное меню: на складе устройство держат одной рукой,
         и переключение должно доставаться большим пальцем. -->
    <TabBar>
        <!-- Сборка первой: это основная работа на складе.
             Значки белые: панель синяя в обеих темах, поэтому перекрашивать
             их под тему не нужно и контраст не теряется. -->
        <ShellContent x:Name="PickingTab" Title="Сборка" Route="picking" Icon="tab_picking.png" />
        <ShellContent x:Name="OrdersTab" Title="Заказы" Route="orders" Icon="tab_orders.png" />
        <ShellContent x:Name="ScanTab" Title="Поиск" Route="scan" Icon="tab_scan.png" />
        <ShellContent x:Name="SettingsTab" Title="Настройки" Route="settings" Icon="tab_settings.png" />
    </TabBar>

</Shell>
