<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ABCPClient.Mobile.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ABCPClient.Mobile.ViewModels"
    x:DataType="vm:MobileSettingsViewModel"
    Title="Настройки">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Подключение к компьютеру" FontSize="19" FontAttributes="Bold" />
            <Label FontSize="13" TextColor="#666"
                   Text="Задания на сборку хранятся в программе на компьютере — она управляющая. Введите адрес, показанный у неё на вкладке «Сборка», затем код сопряжения. Работает только в сети склада." />

            <Label Text="{Binding HubState}" FontSize="14" FontAttributes="Bold" />

            <Label Text="Адрес компьютера" FontSize="14" TextColor="#555" />
            <Entry Text="{Binding HubAddress}" Placeholder="192.168.0.103:5080" Keyboard="Url"
                   FontSize="17" HeightRequest="50" />

            <Label Text="Имя терминала" FontSize="14" TextColor="#555" />
            <Entry Text="{Binding DeviceName}" Placeholder="ТСД-1" FontSize="17" HeightRequest="50" />

            <Label Text="Код сопряжения" FontSize="14" TextColor="#555" />
            <Entry Text="{Binding PairingCode}" Placeholder="6 цифр" Keyboard="Numeric"
                   FontSize="22" HeightRequest="52" MaxLength="6" />

            <Button Text="Проверить связь" FontSize="16" HeightRequest="50"
                    BackgroundColor="Transparent" TextColor="#1B4F8A" BorderColor="#1B4F8A" BorderWidth="1"
                    Command="{Binding CheckHubCommand}" IsEnabled="{Binding IsNotBusy}" />

            <Button Text="Подключить терминал" FontSize="17" HeightRequest="52"
                    Command="{Binding PairCommand}" IsEnabled="{Binding IsNotBusy}" />

            <Button Text="Забыть подключение" FontSize="14" HeightRequest="44"
                    BackgroundColor="Transparent" TextColor="#B3261E"
                    IsVisible="{Binding IsPaired}"
                    Command="{Binding ForgetHubCommand}" />

            <BoxView HeightRequest="1" Color="#DDD" Margin="0,10" />

            <Label Text="Данные доступа к API" FontSize="19" FontAttributes="Bold" />
            <Label FontSize="13" TextColor="#666"
                   Text="Нужны только для вкладки «Заказы» — она обращается к ABCP напрямую. Для сборки достаточно подключения к компьютеру." />
            <Label FontSize="13" TextColor="#666"
                   Text="Адрес выдаёт менеджер ABCP. Логин и пароль — от пользователя со статусом «API-администратор». Пароль не сохраняется: приложение хранит его md5-хэш в зашифрованном виде." />

            <Label Text="Адрес API" FontSize="14" TextColor="#555" />
            <Entry Text="{Binding BaseUrl}" Placeholder="https://id00000.public.api.abcp.ru"
                   Keyboard="Url" FontSize="17" HeightRequest="50" />

            <Label Text="Логин" FontSize="14" TextColor="#555" />
            <Entry Text="{Binding Login}" Placeholder="api@id00000" FontSize="17" HeightRequest="50" />

            <Label Text="Пароль или md5-хэш" FontSize="14" TextColor="#555" />
            <Entry Text="{Binding Password}" IsPassword="True" FontSize="17" HeightRequest="50" />
            <Label FontSize="12" TextColor="#777" IsVisible="{Binding HasStoredPassword}"
                   Text="Оставьте поле пустым, чтобы сохранить прежний пароль." />

            <BoxView HeightRequest="1" Color="#DDD" Margin="0,6" />

            <Label Text="Витрина магазина" FontSize="19" FontAttributes="Bold" />
            <Label FontSize="13" TextColor="#666"
                   Text="Источник наименований и изображений, не расходующий лимит вызовов API. Работает по страницам товара вашего сайта." />

            <Entry Text="{Binding StorefrontUrl}" Placeholder="https://da174.ru" Keyboard="Url"
                   FontSize="17" HeightRequest="50" />

            <BoxView HeightRequest="1" Color="#DDD" Margin="0,6" />

            <Button Text="Проверить подключение" FontSize="17" HeightRequest="52"
                    Command="{Binding TestConnectionCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Text="Сохранить" FontSize="17" HeightRequest="52"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Label Text="{Binding StatusMessage}" FontSize="15" FontAttributes="Bold"
                   LineBreakMode="WordWrap" />

            <Label Text="{Binding VersionText}" FontSize="12" TextColor="#888" Margin="0,10,0,0" />
            <Label Text="{Binding DataDirectory}" FontSize="10" TextColor="#AAA" LineBreakMode="CharacterWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
