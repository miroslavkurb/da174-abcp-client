<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ABCPClient.Mobile.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ABCPClient.Mobile.ViewModels"
    x:DataType="vm:ScanViewModel"
    Title="Поиск детали">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Поле ввода держит фокус: аппаратный сканер работает как клавиатура
             и подставляет штрихкод именно в него, завершая ввод переводом строки. -->
        <Grid Grid.Row="0" Padding="12,12,12,6" ColumnDefinitions="*,Auto" ColumnSpacing="8"
              BackgroundColor="#F2F5F8">
            <Entry x:Name="ScanInput" Grid.Column="0"
                   Text="{Binding Input}"
                   Placeholder="Штрихкод или артикул"
                   FontSize="20"
                   HeightRequest="52"
                   ClearButtonVisibility="WhileEditing"
                   ReturnType="Search"
                   ReturnCommand="{Binding LookupCommand}" />

            <Button Grid.Column="1" Text="Найти" FontSize="17" HeightRequest="52" MinimumWidthRequest="96"
                    Command="{Binding LookupCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        </Grid>

        <Grid Grid.Row="1" Padding="12,0,12,10" ColumnDefinitions="*,Auto" BackgroundColor="#F2F5F8">
            <Label Grid.Column="0" Text="{Binding StatusMessage}" FontSize="14" TextColor="#555"
                   LineBreakMode="WordWrap" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Сброс" FontSize="14" HeightRequest="40" MinimumWidthRequest="80"
                    BackgroundColor="Transparent" TextColor="#1B4F8A"
                    Command="{Binding ClearCommand}" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
                    <Label Text="Ничего не найдено" FontSize="19" HorizontalTextAlignment="Center" />
                    <Label FontSize="14" TextColor="#666" HorizontalTextAlignment="Center"
                           Text="Штрихкоды и наименования попадают в базу из выгрузки каталога магазина. Загрузите её в настольной программе, иначе искать можно только по артикулу уже виденных деталей." />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:FoundArticleViewModel">
                    <Grid Padding="12,10" ColumnDefinitions="72,*" ColumnSpacing="12"
                          RowDefinitions="Auto,Auto,Auto">

                        <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                               Source="{Binding Image}" Aspect="AspectFit"
                               HeightRequest="72" WidthRequest="72" BackgroundColor="#EFEFEF" />

                        <Label Grid.Row="0" Grid.Column="1" FontSize="18" FontAttributes="Bold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Brand, Mode=OneWay}" />
                                    <Span Text=" " />
                                    <Span Text="{Binding Number, Mode=OneWay}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label Grid.Row="1" Grid.Column="1" FontSize="15" TextColor="#333"
                               LineBreakMode="WordWrap" MaxLines="3"
                               Text="{Binding Description, Mode=OneWay}" />

                        <Label Grid.Row="2" Grid.Column="1" FontSize="12" TextColor="#777"
                               LineBreakMode="TailTruncation"
                               Text="{Binding Barcodes, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Задел под сборку: кнопка появится, когда узел склада начнёт выдавать
             задания. Сейчас показывать нечего, поэтому её нет вовсе, а не заглушка. -->
        <Label Grid.Row="3" Padding="12,10" FontSize="12" TextColor="#777" BackgroundColor="#F2F5F8"
               Text="Сканирование работает и аппаратным сканером терминала, и вводом с клавиатуры." />
    </Grid>
</ContentPage>
