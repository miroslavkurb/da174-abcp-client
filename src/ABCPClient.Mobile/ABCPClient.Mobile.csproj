<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Только Android: терминалы сборки и телефоны на складе. Остальные цели
         шаблона убраны, чтобы сборка не требовала macOS и не занимала время. -->
    <TargetFrameworks>net8.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>ABCPClient.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>ABCP Склад</ApplicationTitle>
    <ApplicationId>ru.da174.abcpclient</ApplicationId>

    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android 5.0: терминалы сбора данных нередко живут на старых версиях. -->
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>

    <!-- Документация к элементам интерфейса не требуется, а генерация файла
         на Android поднимает шум предупреждений из сгенерированного кода. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Стиль оформления шаблона MAUI не совпадает с нашим (табуляции,
         пространства имён), а править сгенерированные файлы бессмысленно. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Обрезка неиспользуемого кода отключена намеренно. EF Core и внедрение
       зависимостей работают через отражение, и компоновщик вырезает то, на что
       нет прямых ссылок: приложение собирается, но падает при запуске уже
       на устройстве. Цена — размер APK, и она здесь приемлема: приложение
       раздаётся файлом внутри компании, а не через магазин. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Компиляция в машинный код в Release включена по умолчанию, но требует
         обрезки, а её мы выключили. Без AOT приложение запускается чуть дольше —
         это дешевле, чем падение из-за вырезанного кода. -->
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <!-- Пути к Android SDK и JDK, которые скачивает `dotnet build -t:InstallAndroidDependencies`.
       Заданы условно: если каталогов нет, сборка ищет их обычным путём (ANDROID_HOME,
       JAVA_HOME), поэтому на сервере сборки это ничего не ломает. Смысл в том, чтобы
       локальная сборка решения работала без выставления переменных среды вручную. -->
  <PropertyGroup Condition="'$(AndroidSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk')">
    <AndroidSdkDirectory>$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <!-- Отдельный JDK 17 вместо JAVA_HOME: .NET 8 Android рассчитан на 17,
       а в системе может стоять другая версия, нужная прочим программам. -->
  <PropertyGroup Condition="'$(JavaSdkDirectory)' == '' And Exists('$(LOCALAPPDATA)\Android\jdk')">
    <JavaSdkDirectory>$(LOCALAPPDATA)\Android\jdk</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ABCPClient.Application\ABCPClient.Application.csproj" />
    <ProjectReference Include="..\ABCPClient.Contracts\ABCPClient.Contracts.csproj" />
    <ProjectReference Include="..\ABCPClient.Domain\ABCPClient.Domain.csproj" />
    <ProjectReference Include="..\ABCPClient.Infrastructure\ABCPClient.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B4F8A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1B4F8A" BaseSize="128,128" />

    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

</Project>
