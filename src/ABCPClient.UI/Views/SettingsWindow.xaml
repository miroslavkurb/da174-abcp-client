<Window x:Class="ABCPClient.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ABCPClient.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Настройки подключения" Height="760" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="#555"
                   Text="Адрес API выдаёт менеджер ABCP. Логин и пароль — от пользователя со статусом «API-администратор» (Настройки → Система → Данные для доступа к API). Пароль не сохраняется: приложение хранит его md5-хэш в зашифрованном виде." />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Адрес API" VerticalAlignment="Center" Margin="0,6" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6" Padding="4,3"
                     Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин" VerticalAlignment="Center" Margin="0,6" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="4,3"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль или md5-хэш" VerticalAlignment="Center" Margin="0,6" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                <PasswordBox x:Name="PasswordInput" Padding="4,3" PasswordChanged="OnPasswordChanged" />
                <TextBlock Foreground="#777" FontSize="11" Margin="0,4,0,0"
                           Text="Оставьте поле пустым, чтобы сохранить прежний пароль."
                           Visibility="{Binding HasStoredPassword, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Таймаут запроса, с" VerticalAlignment="Center" Margin="0,6" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Padding="4,3" Width="120"
                     HorizontalAlignment="Left"
                     Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Интервал опроса, с" VerticalAlignment="Center" Margin="0,6" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6" Padding="4,3" Width="120"
                     HorizontalAlignment="Left"
                     Text="{Binding PollingIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,10" Content="Показывать уведомления Windows"
                      IsChecked="{Binding NotificationsEnabled}" />

            <Separator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12" />

            <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#555"
                       Margin="0,0,0,10"
                       Text="Карточки товаров берутся бесплатно, минуя лимит API. Выгрузка каталога (панель управления → Экспорт прайс-листа, формат YML) закрывает собственное наличие: описания, свойства, изображения и штрихкоды. Адрес витрины закрывает остальное — детали под заказ читаются со страниц товара вашего же сайта." />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Выгрузка каталога" VerticalAlignment="Center" Margin="0,6" />
            <Grid Grid.Row="8" Grid.Column="1" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Padding="4,3"
                         Text="{Binding CatalogFeedPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Обзор…" Padding="10,3" Margin="8,0,0,0"
                        Command="{Binding BrowseCatalogCommand}" />
            </Grid>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Адрес витрины" VerticalAlignment="Center" Margin="0,6" />
            <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,6">
                <TextBox Padding="4,3" Text="{Binding StorefrontUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Foreground="#777" FontSize="11" Margin="0,4,0,0"
                           Text="Например https://da174.ru — адрес интернет-магазина. Пусто — источник выключен." />
            </StackPanel>

            <CheckBox Grid.Row="10" Grid.Column="1" Margin="0,8"
                      Content="Скачать все изображения каталога сразу (дольше, зато карточки открываются мгновенно)"
                      IsChecked="{Binding CatalogPrefetchImages}" />

            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                <Button Content="Импортировать каталог" Padding="12,5"
                        Command="{Binding ImportCatalogCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />
                <TextBlock Text="{Binding CatalogLastImport}" Foreground="#777" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Проверить подключение" Padding="12,5" Margin="0,0,8,0"
                    Command="{Binding TestConnectionCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />
            <Button Content="Сохранить" Padding="12,5" Margin="0,0,8,0" Click="OnSave"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />
            <Button Content="Закрыть" Padding="12,5" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
