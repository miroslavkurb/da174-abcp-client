<Window x:Class="ABCPClient.UI.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ABCPClient.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UpdateViewModel}"
        Title="Обновление программы" Height="520" Width="620"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Установлена версия" Foreground="#555" />
            <TextBlock Text="{Binding CurrentVersion}" FontWeight="SemiBold" Margin="6,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="Доступна версия" Foreground="#555" />
            <TextBlock Text="{Binding AvailableVersion}" FontWeight="SemiBold" Margin="6,0,0,0"
                       Foreground="#1B7F3B" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="10"
                Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </ScrollViewer>
        </Border>

        <ProgressBar Grid.Row="3" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1"
                     Value="{Binding Progress, Mode=OneWay}"
                     Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibility}}" />

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Проверить снова" Padding="12,5" Margin="0,0,8,0"
                    Command="{Binding CheckNowCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" />

            <Button Content="Страница выпуска" Padding="12,5" Margin="0,0,8,0"
                    Command="{Binding OpenReleasePageCommand}"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibility}}" />

            <Button Content="Загрузить" Padding="12,5" Margin="0,0,8,0"
                    Command="{Binding DownloadCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                    Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibility}}" />

            <Button Content="Установить и перезапустить" Padding="12,5" Margin="0,0,8,0"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}"
                    Visibility="{Binding IsDownloaded, Converter={StaticResource BooleanToVisibility}}" />

            <Button Content="Закрыть" Padding="12,5" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
