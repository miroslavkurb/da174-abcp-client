<Window x:Class="ABCPClient.UI.Views.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ABCPClient.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OrderDetailsViewModel}"
        Title="{Binding Header, Mode=OneWay, TargetNullValue='Карточка заказа'}"
        Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.ico">

    <DockPanel>

        <!-- Шапка заказа -->
        <Border DockPanel.Dock="Top" Background="#F8F8F8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Header}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Customer}" Margin="0,6,0,0" Foreground="#444" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"
                               Text="{Binding DeliveryInfo}" />
                    <TextBlock Margin="0,2,0,0" Foreground="#666" TextWrapping="Wrap"
                               Text="{Binding PaymentInfo}" />
                    <TextBlock Margin="0,6,0,0" Foreground="#B45309" TextWrapping="Wrap"
                               Text="{Binding Comment}" />
                    <TextBlock Margin="0,6,0,0" Foreground="#B91C1C" FontWeight="SemiBold"
                               Text="Заказ удалён в панели управления"
                               Visibility="{Binding IsDeleted, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Sum, StringFormat='{}{0:N2} ₽'}"
                               FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0"
                               HorizontalAlignment="Right" Foreground="#444" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Нижняя строка: состояние загрузки карточек товаров -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Позиции заказа с изображениями -->
        <ListBox ItemsSource="{Binding Positions}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,1" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <!-- Изображение товара; пока не загрузилось — рамка с подписью -->
                            <Border Grid.Column="0" Width="96" Height="96" BorderBrush="#E5E7EB"
                                    BorderThickness="1" Background="#FAFAFA" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock Text="нет фото" FontSize="10" Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Stretch="Uniform" Margin="3"
                                           Source="{Binding ImagePath, Mode=OneWay, Converter={StaticResource FilePathToImage}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <!-- Mode=OneWay обязателен: у Run.Text привязка по умолчанию
                                     двусторонняя, а свойства позиции только для чтения. -->
                                <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap">
                                    <Run Text="{Binding Brand, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Number, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="#374151" />
                                <TextBlock Text="{Binding Properties}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="#6B7280" FontSize="11" />
                                <TextBlock Margin="0,6,0,0" Foreground="#6B7280" FontSize="11">
                                    <Run Text="Поставщик:" />
                                    <Run Text="{Binding Distributor, Mode=OneWay}" />
                                    <Run Text="   Срок:" />
                                    <Run Text="{Binding DeadlineText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding CancelRequestText}" Foreground="#B45309"
                                           FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold">
                                    <Run Text="{Binding Quantity, Mode=OneWay, StringFormat='{}{0:0.##}'}" />
                                    <Run Text="×" />
                                    <Run Text="{Binding PriceOut, Mode=OneWay, StringFormat='{}{0:N2}'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} ₽'}"
                                           HorizontalAlignment="Right" Margin="0,4,0,0" FontSize="14" />
                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Right"
                                           Margin="0,8,0,0" Foreground="#374151" TextWrapping="Wrap"
                                           TextAlignment="Right" />
                                <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0"
                                           Foreground="#9CA3AF" FontSize="11"
                                           Text="{Binding StatusChangeDate, StringFormat='dd.MM.yyyy HH:mm'}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
