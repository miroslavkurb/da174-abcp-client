<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ABCPClient.Application\ABCPClient.Application.csproj" />
    <ProjectReference Include="..\ABCPClient.Domain\ABCPClient.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows-специфичная платформа: слой использует Windows DPAPI (ProtectedData)
         для шифрования сохранённых секретов. Domain и Application остаются net8.0. -->
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тестам нужен доступ к внутренним настройкам поведения (например,
         задержке перед повтором запроса), чтобы не ждать реального времени. -->
    <InternalsVisibleTo Include="ABCPClient.Tests" />
  </ItemGroup>

</Project>
