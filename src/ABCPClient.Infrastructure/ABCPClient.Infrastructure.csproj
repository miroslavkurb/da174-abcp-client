<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ABCPClient.Application\ABCPClient.Application.csproj" />
    <ProjectReference Include="..\ABCPClient.Domain\ABCPClient.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.29" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.29" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Две цели вместо одной: клиент API, база и кэш изображений от платформы
         не зависят и нужны мобильному приложению, а шифрование секретов через
         Windows DPAPI (ProtectedData) существует только под Windows.
         В сборке net8.0 файл DpapiSecretProtector исключён, а реализацию
         ISecretProtector обязана предоставить платформа-хозяин
         (на Android это хранилище ключей через MAUI SecureStorage). -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Security\DpapiSecretProtector.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тестам нужен доступ к внутренним настройкам поведения (например,
         задержке перед повтором запроса), чтобы не ждать реального времени. -->
    <InternalsVisibleTo Include="ABCPClient.Tests" />
  </ItemGroup>

</Project>
