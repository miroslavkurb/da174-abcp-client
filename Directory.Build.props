<Project>

  <!-- Общие настройки компиляции для всех проектов решения. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>ru-RU</NeutralLanguage>

    <!-- XML-документация обязательна по требованиям проекта.
         CS1591 (нет комментария к публичному члену) оставлен предупреждением,
         чтобы не блокировать сборку на промежуточных этапах. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Сведения о продукте попадают в свойства файла и в журнал при запуске.
       Версия по умолчанию — для локальных сборок; при выпуске релиза её задаёт
       рабочий процесс из имени тега (-p:Version=1.2.3). -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>ABCP Client</Product>
    <Company>ООО «Дойч-Авто ДА»</Company>
    <Authors>miroslavkurb</Authors>
    <Copyright>© ООО «Дойч-Авто ДА»</Copyright>
  </PropertyGroup>

</Project>
